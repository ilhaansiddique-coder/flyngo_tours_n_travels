# =============================================================================
# FLYNGO — Coolify Environment Variables
# Paste these into Coolify → Project → Environment Variables
# Replace every <PLACEHOLDER> with your real value
# =============================================================================

PRIMARY_DOMAIN=flyngo.world

# -----------------------------------------------------------------------------
# Database (Coolify Service: flyngo-db — PostgreSQL 16)
# Internal host is shown on the service detail page in Coolify, e.g.
#   http://flyngo-db:5432  →  host: flyngo-db
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://flyngo:<DB_PASSWORD>@flyngo-db:5432/flyngo?schema=public

# -----------------------------------------------------------------------------
# Redis (Coolify Service: flyngo-redis)
# -----------------------------------------------------------------------------
REDIS_HOST=flyngo-redis
REDIS_PORT=6379
REDIS_PASSWORD=<REDIS_PASSWORD>

# -----------------------------------------------------------------------------
# Meilisearch (Coolify Service: flyngo-meili)
# -----------------------------------------------------------------------------
MEILISEARCH_HOST=http://flyngo-meili:7700
MEILISEARCH_API_KEY=<MEILISEARCH_MASTER_KEY>

# -----------------------------------------------------------------------------
# JWT — generate with: openssl rand -hex 32
# -----------------------------------------------------------------------------
JWT_ACCESS_SECRET=<openssl-rand-hex-32>
JWT_REFRESH_SECRET=<openssl-rand-hex-32>
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# -----------------------------------------------------------------------------
# Public URLs (must match domains you attach in Coolify)
# -----------------------------------------------------------------------------
FRONTEND_URL=https://flyngo.world
ADMIN_URL=https://flyngo.world
# Public-facing URLs (baked into frontend at build time)
# These are set as GitHub Actions Variables (not Coolify env vars)
NEXT_PUBLIC_API_URL=https://api.flyngo.world/api/v1
NEXT_PUBLIC_SITE_URL=https://flyngo.world
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# -----------------------------------------------------------------------------
# Stripe (https://dashboard.stripe.com/apikeys)
# -----------------------------------------------------------------------------
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# -----------------------------------------------------------------------------
# bKash / Nagad / SSLCommerz (Bangladesh payments)
# Leave empty until you have the credentials.
# -----------------------------------------------------------------------------
BKASH_API_KEY=
BKASH_SECRET_KEY=
BKASH_USERNAME=
BKASH_PASSWORD=
BKASH_BASE_URL=https://tokenized.pay.bka.sh/v1.2.0-beta

NAGAD_MERCHANT_ID=
NAGAD_SECRET_KEY=
NAGAD_BASE_URL=

SSLC_STORE_ID=
SSLC_STORE_PASSWORD=
SSLC_BASE_URL=https://securepay.sslcommerz.com

# -----------------------------------------------------------------------------
# Google Maps (https://console.cloud.google.com)
# -----------------------------------------------------------------------------
GOOGLE_MAPS_API_KEY=

# -----------------------------------------------------------------------------
# Resend (https://resend.com/api-keys)
# -----------------------------------------------------------------------------
RESEND_API_KEY=
EMAIL_FROM=noreply@flyngo.com

# -----------------------------------------------------------------------------
# Twilio (SMS)
# -----------------------------------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# -----------------------------------------------------------------------------
# Firebase Admin (Push notifications)
# Paste the entire private key including BEGIN/END lines, with \n escaped.
# -----------------------------------------------------------------------------
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=

# -----------------------------------------------------------------------------
# Cloudflare R2 (object storage)
# -----------------------------------------------------------------------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=flyngo-media
R2_PUBLIC_URL=https://media.flyngo.world

# -----------------------------------------------------------------------------
# Marketing analytics — leave empty if not used
# -----------------------------------------------------------------------------
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_TIKTOK_PIXEL_ID=
NEXT_PUBLIC_CLARITY_ID=
