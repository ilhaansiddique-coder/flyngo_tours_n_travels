# =============================================================================
# VBT — Root Environment Variables
# Copy to .env and fill in values.
# =============================================================================

NODE_ENV=development

# =============================================================================
# Backend
# =============================================================================
BACKEND_PORT=4000
BACKEND_HOST=0.0.0.0

# Separate database (PostgreSQL 16). On Coolify create a dedicated database
# resource for VBT and paste its DATABASE_URL here. MySQL is not supported.
DATABASE_URL=postgresql://vbt:vbt@localhost:5432/vbt?schema=public

# Admin panel credentials used at seed time (login: /admin/auth/login).
ADMIN_EMAIL=admin@vbt.world
ADMIN_PASSWORD=admin123
JWT_ACCESS_SECRET=change-me-vbt-access-secret
JWT_ACCESS_EXPIRY=24h

# Frontend origin (for CORS)
FRONTEND_URL=http://localhost:3000

# =============================================================================
# Frontend
# =============================================================================
BACKEND_URL=http://localhost:4000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Sub-path the site is served from (matches the Coolify proxy path).
NEXT_PUBLIC_VBT_BASE_PATH=/VBT
# Build-time flag to disable the /VBT prefix when serving at the domain root.
NEXT_PUBLIC_VBT_USE_BASEPATH=true