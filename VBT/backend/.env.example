# =============================================================================
# VBT Backend — Environment Variables
# Copy to .env and fill in.
# =============================================================================

NODE_ENV=development
BACKEND_PORT=4000
BACKEND_HOST=0.0.0.0

# Separate database, e.g. the one you create on Coolify:
#   postgresql://USER:PASSWORD@HOST:PORT/DBNAME?schema=public
DATABASE_URL=postgresql://vbt:vbt@localhost:5432/vbt?schema=public

# Admin credentials (upserted during every seed)
ADMIN_EMAIL=admin@vbt.world
ADMIN_PASSWORD=admin123

JWT_ACCESS_SECRET=change-me-vbt-access-secret
JWT_ACCESS_EXPIRY=24h

FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=

# Set true in production to expose Swagger at /api/docs
ENABLE_SWAGGER=false