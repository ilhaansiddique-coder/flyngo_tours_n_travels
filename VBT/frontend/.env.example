# =============================================================================
# VBT Frontend — Environment Variables
# Copy to .env.local
# =============================================================================

# Internal backend URL used by Next.js server (rewrites /VBT/api -> backend).
# In Docker the backend service is reachable at http://backend:4000.
BACKEND_URL=http://localhost:4000

# Public site URL (used in metadata / sitemap / OpenGraph).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Sub-path the site is served at. Keep as /VBT so the site opens at
# https://flyngo.world/VBT. Set NEXT_PUBLIC_VBT_USE_BASEPATH=false to serve
# at the domain root instead.
NEXT_PUBLIC_VBT_BASE_PATH=/VBT
NEXT_PUBLIC_VBT_USE_BASEPATH=true