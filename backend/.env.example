# Backend
BACKEND_PORT=4000
BACKEND_HOST=0.0.0.0

# Database
DATABASE_URL=postgresql://flyngo:flyngo@localhost:5432/flyngo?schema=public

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT
# MUST be set to long random values in production. docker-compose falls back to
# "change-me-*" if these are unset, and those defaults are public in this repo —
# anyone could then forge a super-admin token.
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_EXPIRY=24h
JWT_REFRESH_EXPIRY=24h

# Seed / bootstrap
# Password for the seeded super-admin (admin@flyngo.com). REQUIRED when seeding
# with NODE_ENV=production — the seed now refuses to run without it rather than
# silently installing a known default. Setting this and redeploying also ROTATES
# an existing admin's password, which is the only rotation path on a host with
# no shell access.
SUPER_ADMIN_PASSWORD=

# Seed the fabricated demo catalogue (sample tours/hotels/flights/transport and
# stock testimonials). Leave false on any real site: the seed runs on every
# container boot, and these rows are invented marketing content.
SEED_DEMO_CONTENT=false

# Publish Swagger at /api/docs. Off in production by default — it maps every
# admin route for anyone who asks.
ENABLE_SWAGGER=false

# Dev-only convenience: return the password reset URL in the forgot-password
# response so you can reset without email/SMS configured. IGNORED when
# NODE_ENV=production. In production, use the admin-only endpoint
# POST /api/v1/auth/admin/password-reset-link instead.
EXPOSE_PASSWORD_RESET_LINK=false

# Frontend URLs (CORS)
FRONTEND_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001

# Stripe
STRIPE_SECRET_KEY=sk_test_
STRIPE_WEBHOOK_SECRET=whsec_

# bKash
BKASH_API_KEY=
BKASH_SECRET_KEY=
BKASH_USERNAME=
BKASH_PASSWORD=
BKASH_BASE_URL=https://tokenized.sandbox.bka.sh/v1.2.0-beta

# Nagad
NAGAD_MERCHANT_ID=
NAGAD_SECRET_KEY=
NAGAD_BASE_URL=

# SSLCommerz
SSLC_STORE_ID=
SSLC_STORE_PASSWORD=
SSLC_BASE_URL=https://sandbox.sslcommerz.com

# Google Maps
GOOGLE_MAPS_API_KEY=

# Resend
RESEND_API_KEY=
EMAIL_FROM=noreply@flyngo.com

# bulkSMSbd.net (Bangladesh SMS gateway) — https://bulksmsbd.net
# Sender ID 8809648906698 is the default; override if you have an approved one.
# Leave SMS_API_KEY blank to log SMS sends instead of delivering them.
SMS_API_KEY=
SMS_SENDER_ID=8809648906698

# Firebase
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=

# Meilisearch
MEILISEARCH_HOST=http://localhost:7700
MEILISEARCH_API_KEY=

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# OAuth — Google (https://console.cloud.google.com/apis/credentials)
# Authorized redirect URI: ${API_PUBLIC_URL}/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# OAuth — Facebook (https://developers.facebook.com/apps)
# Valid OAuth Redirect URI: ${API_PUBLIC_URL}/api/v1/auth/facebook/callback
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# Public backend URL — used to build absolute OAuth callback URLs.
# In Coolify, set to the FQDN attached to the backend container
# (e.g. https://api.flyngo.world). Leave empty in local dev to fall back to FRONTEND_URL.
API_PUBLIC_URL=
