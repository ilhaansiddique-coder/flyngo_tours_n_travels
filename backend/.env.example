# Backend
BACKEND_PORT=4000
BACKEND_HOST=0.0.0.0

# Database
DATABASE_URL=postgresql://flyngo:flyngo@localhost:5432/flyngo?schema=public

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Frontend URLs (CORS)
FRONTEND_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001

# Stripe
STRIPE_SECRET_KEY=sk_test_
STRIPE_WEBHOOK_SECRET=whsec_

# bKash
BKASH_API_KEY=
BKASH_SECRET_KEY=
BKASH_USERNAME=
BKASH_PASSWORD=
BKASH_BASE_URL=https://tokenized.sandbox.bka.sh/v1.2.0-beta

# Nagad
NAGAD_MERCHANT_ID=
NAGAD_SECRET_KEY=
NAGAD_BASE_URL=

# SSLCommerz
SSLC_STORE_ID=
SSLC_STORE_PASSWORD=
SSLC_BASE_URL=https://sandbox.sslcommerz.com

# Google Maps
GOOGLE_MAPS_API_KEY=

# Resend
RESEND_API_KEY=
EMAIL_FROM=noreply@flyngo.com

# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Firebase
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=

# Meilisearch
MEILISEARCH_HOST=http://localhost:7700
MEILISEARCH_API_KEY=

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# OAuth — Google (https://console.cloud.google.com/apis/credentials)
# Authorized redirect URI: ${API_PUBLIC_URL}/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# OAuth — Facebook (https://developers.facebook.com/apps)
# Valid OAuth Redirect URI: ${API_PUBLIC_URL}/api/v1/auth/facebook/callback
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# Public backend URL — used to build absolute OAuth callback URLs.
# In Coolify, set to the FQDN attached to the backend container
# (e.g. https://api.flyngo.world). Leave empty in local dev to fall back to FRONTEND_URL.
API_PUBLIC_URL=
