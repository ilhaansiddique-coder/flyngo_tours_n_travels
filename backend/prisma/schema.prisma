// =============================================================================
// HAJJ / UMRAH BOOKINGS (real bookings, as distinct from lead capture)
// =============================================================================

model HajjUmrahBooking {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")
  // Nullable so guests can book without an account, exactly like the generic
  // Booking. Signed-in users are still linked via OptionalJwtAuthGuard.
  userId   String? @map("user_id")
  user     User?   @relation(fields: [userId], references: [id])

  // Public tracking code (FLY-XXXX-XXXX) shown after checkout, so a pilgrimage
  // booking is lookup-able on /track just like every other booking type.
  bookingCode String? @unique @map("booking_code")

  // Lead contact captured on the form. Kept on the booking itself (not only on
  // the user) so guest bookings still show a name + phone in the admin table.
  customerName  String? @map("customer_name")
  customerPhone String? @map("customer_phone")
  customerEmail String? @map("customer_email")

  kind       String // hajj | umrah
  packageId  String @map("package_id") // HajjPackage or UmrahPackage id
  packageTitle String @map("package_title")
  packageSlug  String @map("package_slug")

  // Trip info
  departureDate DateTime  @map("departure_date")
  returnDate    DateTime? @map("return_date")
  durationDays  Int       @default(0) @map("duration_days")

  // Room occupancy: quad / triple / double
  occupancyType String  @default("quad") @map("occupancy_type")
  numPilgrims   Int     @default(1) @map("num_pilgrims")

  // Pricing + payment plan
  currency     String  @default("BDT")
  perPersonAmount Decimal @default(0) @map("per_person_amount") @db.Decimal(10, 2)
  totalAmount  Decimal @default(0) @map("total_amount") @db.Decimal(10, 2)
  advancePaid  Decimal @default(0) @map("advance_paid") @db.Decimal(10, 2)
  balanceDue   Decimal @default(0) @map("balance_due") @db.Decimal(10, 2)
  balanceDueDate DateTime? @map("balance_due_date")
  paymentPlan  String  @default("full") @map("payment_plan") // full | installments

  // Referral: one-time 5% referee discount applied to the first booking made
  // through a referral link. Atomic claim happens in resolveDiscountForUser.
  referralDiscount Decimal @default(0) @map("referral_discount") @db.Decimal(10, 2)
  discountAmount   Decimal @default(0) @map("discount_amount") @db.Decimal(10, 2)
  referredByCode   String? @map("referred_by_code")

  status      String  @default("pending") // pending, confirmed, paid, cancelled, completed
  paymentStatus String @default("unpaid") @map("payment_status") // unpaid, partial, paid, refunded

  // Loyalty points awarded on status transitions (mirrors the generic Booking).
  pointsAwardedConfirmation Int @default(0) @map("points_awarded_confirmation")
  pointsAwardedCompletion   Int @default(0) @map("points_awarded_completion")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  pilgrims Pilgrim[]
  payments Payment[]
  invoices Invoice[]

  @@index([tenantId, userId])
  @@index([tenantId, kind, status])
  @@index([tenantId, packageId])
  @@map("hajj_umrah_bookings")
}

model Pilgrim {
  id        String @id @default(uuid())
  bookingId String @map("booking_id")
  booking   HajjUmrahBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  fullName         String  @map("full_name")
  passportNumber   String  @map("passport_number")
  passportExpiry   DateTime @map("passport_expiry")
  dateOfBirth      DateTime @map("date_of_birth")
  gender           String  @default("male")
  // Required for female pilgrims per Hajj/Umrah rules — blank = not supplying.
  mahramRelation   String? @map("mahram_relation") // spouse, father, son, brother
  relationshipToLead String? @map("relationship_to_lead")

  @@index([bookingId])
  @@map("pilgrims")
}

