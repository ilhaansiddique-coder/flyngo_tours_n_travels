generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearchPostgres"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =============================================================================
// TENANT & MULTI-TENANCY
// =============================================================================

model Tenant {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  domain    String?  @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  settings TenantSettings?
  users    User[]
  roles    Role[]

  @@map("tenants")
}

model TenantSettings {
  id        String   @id @default(uuid())
  tenantId  String   @unique @map("tenant_id")
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  logoUrl        String?  @map("logo_url")
  faviconUrl     String?  @map("favicon_url")
  primaryColor   String?  @map("primary_color") @default("#2563eb")
  secondaryColor String?  @map("secondary_color") @default("#1e40af")

  companyName    String?  @map("company_name")
  companyEmail   String?  @map("company_email")
  companyPhone   String?  @map("company_phone")
  companyAddress String?  @map("company_address")

  defaultCurrency String?  @map("default_currency") @default("USD")
  defaultLanguage String?  @map("default_language") @default("en")
  timezone        String?  @default("UTC")

  // Payment gateway keys (encrypted at rest)
  stripePublicKey  String? @map("stripe_public_key")
  stripeSecretKey  String? @map("stripe_secret_key")
  bkashApiKey      String? @map("bkash_api_key")
  nagadMerchantId  String? @map("nagad_merchant_id")
  sslcStoreId      String? @map("sslc_store_id")

  // Analytics
  ga4Id       String? @map("ga4_id")
  gtmId       String? @map("gtm_id")
  metaPixelId String? @map("meta_pixel_id")

  // Social
  facebookUrl  String? @map("facebook_url")
  instagramUrl String? @map("instagram_url")
  twitterUrl   String? @map("twitter_url")
  youtubeUrl   String? @map("youtube_url")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("tenant_settings")
}

// =============================================================================
// AUTH & USERS
// =============================================================================

model User {
  id           String    @id @default(uuid())
  tenantId     String    @map("tenant_id")
  tenant       Tenant    @relation(fields: [tenantId], references: [id])
  email        String?
  fullName     String    @map("full_name")
  phone        String?
  avatarUrl    String?   @map("avatar_url")
  passwordHash String?   @map("password_hash")
  provider     String?   @map("provider")
  providerId   String?   @map("provider_id")
  roleId       String    @map("role_id")
  role         Role      @relation(fields: [roleId], references: [id])

  isActive         Boolean   @default(true) @map("is_active")
  emailVerifiedAt  DateTime? @map("email_verified_at")
  lastLoginAt      DateTime? @map("last_login_at")
  refreshToken     String?   @map("refresh_token")
  phoneVerifiedAt  DateTime? @map("phone_verified_at")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  bookings      Booking[]
  payments      Payment[]
  notifications Notification[]
  auditLogs     AuditLog[]
  blogPosts     BlogPost[]
  reviews       Review[]

  @@index([tenantId, email])
  @@index([tenantId, phone])
  @@map("users")
}

model Role {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id])
  name     String
  code     String
  isSystem Boolean @default(false) @map("is_system")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  users       User[]
  permissions RolePermission[]

  @@unique([tenantId, code])
  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid())
  name        String
  code        String   @unique
  description String?
  group       String?

  createdAt DateTime @default(now()) @map("created_at")

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  id           String     @id @default(uuid())
  roleId       String     @map("role_id")
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String     @map("permission_id")
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

// =============================================================================
// DESTINATIONS
// =============================================================================

model Destination {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  name        String
  slug        String
  country     String
  continent   String?
  description String?  @db.Text
  imageUrl    String?  @map("image_url")
  coverImageUrl String? @map("cover_image_url")
  latitude    Float?
  longitude   Float?
  isFeatured  Boolean  @default(false) @map("is_featured")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  tours    Tour[]
  hotels   Hotel[]
  visaServices VisaService[]

  @@unique([tenantId, slug])
  @@map("destinations")
}

// =============================================================================
// TOURS
// =============================================================================

model Tour {
  id            String    @id @default(uuid())
  tenantId      String    @map("tenant_id")
  destinationId String    @map("destination_id")
  destination   Destination @relation(fields: [destinationId], references: [id])

  title       String
  slug        String
  description String    @db.Text
  highlights  String[]  @default([])
  inclusions  String[]  @default([])
  exclusions  String[]  @default([])

  price       Decimal   @db.Decimal(10, 2)
  salePrice   Decimal?  @map("sale_price") @db.Decimal(10, 2)
  currency    String    @default("USD")

  duration       Int
  maxGuests      Int     @default(10) @map("max_guests")
  difficulty     String? // easy, moderate, challenging
  tourType       String? @map("tour_type") // group, private, adventure, luxury
  startLocation  String? @map("start_location")
  endLocation    String? @map("end_location")

  isActive       Boolean @default(true) @map("is_active")
  isFeatured     Boolean @default(false) @map("is_featured")

  coverImageUrl  String?  @map("cover_image_url")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  images    Media[]
  itinerary ItineraryDay[]

  @@unique([tenantId, slug])
  @@map("tours")
}

model ItineraryDay {
  id          String @id @default(uuid())
  tourId      String @map("tour_id")
  tour        Tour   @relation(fields: [tourId], references: [id], onDelete: Cascade)
  day         Int
  title       String
  description String  @db.Text
  activities  String[]

  @@unique([tourId, day])
  @@map("itinerary_days")
}

// =============================================================================
// HOTELS
// =============================================================================

model Hotel {
  id            String      @id @default(uuid())
  tenantId      String      @map("tenant_id")
  destinationId String      @map("destination_id")
  destination   Destination @relation(fields: [destinationId], references: [id])

  name         String
  slug         String
  description  String      @db.Text
  starRating   Int         @default(3) @map("star_rating")
  address      String?
  latitude     Float?
  longitude    Float?

  pricePerNight Decimal   @map("price_per_night") @db.Decimal(10, 2)
  currency      String    @default("USD")

  amenities     String[]  @default([])
  checkInTime   String?    @map("check_in_time") @default("14:00")
  checkOutTime  String?    @map("check_out_time") @default("12:00")

  coverImageUrl String?   @map("cover_image_url")

  isActive   Boolean @default(true) @map("is_active")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  images Media[]
  rooms  Room[]

  @@unique([tenantId, slug])
  @@map("hotels")
}

model Room {
  id           String @id @default(uuid())
  hotelId      String @map("hotel_id")
  hotel        Hotel  @relation(fields: [hotelId], references: [id], onDelete: Cascade)

  name         String
  description  String?
  pricePerNight Decimal @map("price_per_night") @db.Decimal(10, 2)
  currency     String  @default("USD")
  capacity     Int
  available    Int     @default(1)
  amenities    String[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("rooms")
}

// =============================================================================
// FLIGHTS
// =============================================================================

model Flight {
  id              String   @id @default(uuid())
  tenantId        String   @map("tenant_id")

  airline         String
  flightNumber    String   @map("flight_number")
  originCode      String   @map("origin_code")
  originCity      String?  @map("origin_city")
  destinationCode String   @map("destination_code")
  destinationCity String?  @map("destination_city")

  coverImageUrl String?  @map("cover_image_url")

  departureTime DateTime @map("departure_time")
  arrivalTime   DateTime @map("arrival_time")
  duration      Int?     // minutes

  price          Decimal  @db.Decimal(10, 2)
  currency       String   @default("USD")
  availableSeats Int      @default(0) @map("available_seats")
  cabinClass     String?  @map("cabin_class") // economy, business, first

  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@map("flights")
}

// =============================================================================
// VISA
// =============================================================================

model VisaService {
  id            String      @id @default(uuid())
  tenantId      String      @map("tenant_id")
  destinationId String      @map("country_id")
  country       Destination @relation(fields: [destinationId], references: [id])

  title        String
  description  String   @db.Text
  processingTime String? @map("processing_time")
  price        Decimal  @db.Decimal(10, 2)
  currency     String   @default("USD")
  requirements String[]

  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@map("visa_services")
}

// =============================================================================
// BOOKINGS
// =============================================================================

model Booking {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  userId      String   @map("user_id")
  user        User     @relation(fields: [userId], references: [id])

  bookingType String   @map("booking_type") // tour, hotel, flight, visa, package
  bookingCode String   @unique @map("booking_code")
  itemId      String   @map("item_id")

  status      String   @default("pending") // pending, confirmed, in_progress, completed, cancelled
  startDate   DateTime @map("start_date")
  endDate     DateTime? @map("end_date")
  guests      Int      @default(1)

  totalAmount   Decimal  @default(0) @map("total_amount") @db.Decimal(10, 2)
  discountAmount Decimal? @default(0) @map("discount_amount") @db.Decimal(10, 2)
  paidAmount    Decimal  @default(0) @map("paid_amount") @db.Decimal(10, 2)
  currency      String   @default("USD")

  couponCode String? @map("coupon_code")
  notes      String?

  // Hotel-specific fields
  hotelId       String? @map("hotel_id")
  roomId        String? @map("room_id")
  hotelName     String? @map("hotel_name")
  roomName      String? @map("room_name")
  roomsCount    Int     @default(1) @map("rooms_count")
  adults        Int     @default(1)
  children      Int     @default(0)
  childAges     Int[]   @default([]) @map("child_ages")
  mealPlan      String? @map("meal_plan") // RO, BB, HB, FB, AI
  nights        Int     @default(1)
  pricePerNight Decimal? @map("price_per_night") @db.Decimal(10, 2)
  arrivalTime   String? @map("arrival_time")
  flightNumber  String? @map("flight_number")

  cancelledAt DateTime? @map("cancelled_at")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  payments  Payment[]
  travelers BookingTraveler[]

  @@index([tenantId, userId])
  @@index([hotelId])
  @@index([roomId])
  @@map("bookings")
}

model BookingTraveler {
  id        String  @id @default(uuid())
  tenantId  String  @map("tenant_id")
  bookingId String  @map("booking_id")
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  isLead    Boolean @default(false) @map("is_lead")
  fullName  String  @map("full_name")
  email     String?
  phone     String?
  age       Int?
  type      String  @default("adult") // adult, child, infant

  createdAt DateTime @default(now()) @map("created_at")

  @@index([bookingId])
  @@map("booking_travelers")
}

// =============================================================================
// PAYMENTS
// =============================================================================

model Payment {
  id            String   @id @default(uuid())
  tenantId      String   @map("tenant_id")
  userId        String   @map("user_id")
  user          User     @relation(fields: [userId], references: [id])
  bookingId     String   @map("booking_id")
  booking       Booking  @relation(fields: [bookingId], references: [id])

  amount        Decimal  @db.Decimal(10, 2)
  currency      String   @default("BDT")
  method        String   // stripe, bkash, nagad, sslcommerz
  status        String   @default("pending") // pending, processing, completed, failed, refunded
  transactionId String   @unique @map("transaction_id")
  gatewayRef    String?  @map("gateway_ref")

  metadata Json?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([tenantId, bookingId])
  @@map("payments")
}

// =============================================================================
// CMS
// =============================================================================

model CmsPage {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")

  title     String
  slug      String
  content   Json?
  status    String   @default("draft") // draft, published, archived
  metaTitle String?  @map("meta_title")
  metaDescription String? @map("meta_description") @db.Text

  publishedAt DateTime? @map("published_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  sections CmsSection[]

  @@unique([tenantId, slug])
  @@map("cms_pages")
}

model CmsSection {
  id       String  @id @default(uuid())
  pageId   String  @map("page_id")
  page     CmsPage @relation(fields: [pageId], references: [id], onDelete: Cascade)

  type     String  // hero, features, testimonials, gallery, cta, custom
  title    String?
  subtitle String?
  content  Json?
  order    Int     @default(0)
  settings Json?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("cms_sections")
}

model BlogPost {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  authorId    String   @map("author_id")
  author      User     @relation(fields: [authorId], references: [id])

  title       String
  slug        String
  excerpt     String?  @db.Text
  content     String   @db.Text
  featuredImage String? @map("featured_image")

  status      String   @default("draft") // draft, published, archived
  isPinned    Boolean  @default(false) @map("is_pinned")

  metaTitle       String?  @map("meta_title")
  metaDescription String?  @map("meta_description") @db.Text
  tags            String[]

  viewCount   Int      @default(0) @map("view_count")

  publishedAt DateTime? @map("published_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  categories BlogPostCategory[]

  @@unique([tenantId, slug])
  @@map("blog_posts")
}

model BlogCategory {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")
  name     String
  slug     String

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  posts BlogPostCategory[]

  @@unique([tenantId, slug])
  @@map("blog_categories")
}

model BlogPostCategory {
  id         String       @id @default(uuid())
  postId     String       @map("post_id")
  post       BlogPost     @relation(fields: [postId], references: [id], onDelete: Cascade)
  categoryId String       @map("category_id")
  category   BlogCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([postId, categoryId])
  @@map("blog_post_categories")
}

model Testimonial {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")

  customerName  String  @map("customer_name")
  customerTitle String? @map("customer_title")
  customerImage String? @map("customer_image")
  content       String  @db.Text
  rating        Int     @default(5)
  isApproved    Boolean @default(false) @map("is_approved")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@map("testimonials")
}

model Faq {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")

  question   String
  answer     String  @db.Text
  category   String?
  order      Int     @default(0)
  isPublished Boolean @default(false) @map("is_published")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@map("faqs")
}

// =============================================================================
// MARKETING
// =============================================================================

model Coupon {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")

  code        String
  type        String   // percentage, fixed
  value       Decimal  @db.Decimal(10, 2)
  minPurchase Decimal? @map("min_purchase") @db.Decimal(10, 2)
  maxDiscount Decimal? @map("max_discount") @db.Decimal(10, 2)

  maxUses     Int      @default(0) @map("max_uses") // 0 = unlimited
  usedCount   Int      @default(0) @map("used_count")

  startDate   DateTime @map("start_date")
  endDate     DateTime @map("end_date")
  isActive    Boolean  @default(true) @map("is_active")

  applicableTo String[] @default([]) @map("applicable_to") // tour, hotel, flight, visa

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@unique([tenantId, code])
  @@map("coupons")
}

model Affiliate {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  userId    String   @unique @map("user_id")

  referralCode String  @unique @map("referral_code")
  commissionRate Decimal @default(5.0) @map("commission_rate") @db.Decimal(5, 2)
  totalEarnings  Decimal @default(0)   @map("total_earnings") @db.Decimal(10, 2)

  isActive  Boolean  @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  referrals   AffiliateReferral[]
  commissions AffiliateCommission[]

  @@map("affiliates")
}

model AffiliateReferral {
  id          String    @id @default(uuid())
  tenantId    String    @map("tenant_id")
  affiliateId String    @map("affiliate_id")
  affiliate   Affiliate @relation(fields: [affiliateId], references: [id])

  referredUserId String @map("referred_user_id")
  status         String @default("pending") // pending, registered, converted

  createdAt DateTime @default(now()) @map("created_at")

  @@map("affiliate_referrals")
}

model AffiliateCommission {
  id          String    @id @default(uuid())
  tenantId    String    @map("tenant_id")
  affiliateId String    @map("affiliate_id")
  affiliate   Affiliate @relation(fields: [affiliateId], references: [id])

  bookingId String  @map("booking_id")
  amount    Decimal @db.Decimal(10, 2)
  status    String  @default("pending") // pending, paid, cancelled

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("affiliate_commissions")
}

// =============================================================================
// NOTIFICATIONS
// =============================================================================

model Notification {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")
  userId   String @map("user_id")
  user     User   @relation(fields: [userId], references: [id])

  type    String  // email, sms, push, in_app
  title   String
  body    String  @db.Text
  data    Json?

  readAt    DateTime? @map("read_at")
  sentAt    DateTime? @map("sent_at")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([tenantId, userId])
  @@map("notifications")
}

// =============================================================================
// AUDIT LOG
// =============================================================================

model AuditLog {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")
  userId   String? @map("user_id")
  user     User?   @relation(fields: [userId], references: [id])

  action   String
  entity   String
  entityId String? @map("entity_id")
  oldValue Json?   @map("old_value")
  newValue Json?   @map("new_value")
  ipAddress String? @map("ip_address")
  userAgent String? @map("user_agent")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([tenantId, userId])
  @@index([tenantId, entity])
  @@map("audit_logs")
}

// =============================================================================
// MEDIA
// =============================================================================

model Media {
  id       String   @id @default(uuid())
  tenantId String   @map("tenant_id")

  url      String
  alt      String?
  width    Int?
  height   Int?
  size     Int?    // bytes
  mimeType String? @map("mime_type")
  filename String? @map("filename")
  folder   String? @map("folder")

  tourId  String? @map("tour_id")
  tour    Tour?   @relation(fields: [tourId], references: [id], onDelete: Cascade)
  hotelId String? @map("hotel_id")
  hotel   Hotel?  @relation(fields: [hotelId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([tenantId])
  @@index([tourId])
  @@index([hotelId])
  @@map("media")
}

// =============================================================================
// HOMEPAGE HERO SECTION (one per tenant)
// =============================================================================

model HeroSection {
  id       String @id @default(uuid())
  tenantId String @unique @map("tenant_id")

  badgeTextEn        String? @map("badge_text_en")
  badgeTextBn        String? @map("badge_text_bn")
  titleLineAEn       String? @map("title_line_a_en")
  titleLineABn       String? @map("title_line_a_bn")
  titleLineBEn       String? @map("title_line_b_en")
  titleLineBBn       String? @map("title_line_b_bn")
  titleLineCEn       String? @map("title_line_c_en")
  titleLineCBn       String? @map("title_line_c_bn")
  subtitleEn         String? @db.Text @map("subtitle_en")
  subtitleBn         String? @db.Text @map("subtitle_bn")
  ctaExploreEn       String? @map("cta_explore_en")
  ctaExploreBn       String? @map("cta_explore_bn")
  ctaVisaEn          String? @map("cta_visa_en")
  ctaVisaBn          String? @map("cta_visa_bn")
  ctaDestinationsEn  String? @map("cta_destinations_en")
  ctaDestinationsBn  String? @map("cta_destinations_bn")
  stats              Json    @default("[]")
  quickPlaces        String[] @default([]) @map("quick_places")
  isActive           Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("hero_sections")
}

// =============================================================================
// GLOBE CITIES + ROUTES (powers the home hero globe animation)
// =============================================================================

model GlobeCity {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")

  nameEn String  @map("name_en")
  nameBn String? @map("name_bn")
  lat    Float
  lon    Float

  isActive  Boolean @default(true) @map("is_active")
  sortOrder Int     @default(0) @map("sort_order")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  routesFrom GlobeRoute[] @relation("GlobeRouteFrom")
  routesTo   GlobeRoute[] @relation("GlobeRouteTo")

  @@index([tenantId])
  @@map("globe_cities")
}

model GlobeRoute {
  id         String @id @default(uuid())
  tenantId   String @map("tenant_id")
  fromCityId String @map("from_city_id")
  toCityId   String @map("to_city_id")

  fromCity GlobeCity @relation("GlobeRouteFrom", fields: [fromCityId], references: [id], onDelete: Cascade)
  toCity   GlobeCity @relation("GlobeRouteTo",   fields: [toCityId],   references: [id], onDelete: Cascade)

  isActive  Boolean @default(true) @map("is_active")
  sortOrder Int     @default(0) @map("sort_order")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([tenantId])
  @@index([fromCityId])
  @@index([toCityId])
  @@map("globe_routes")
}

// =============================================================================
// VISA COUNTRIES (curated country-level cards for the visa grid — Malaysia, UK, etc.)
// =============================================================================

model VisaCountry {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")

  name        String
  slug        String
  flagUrl     String?  @map("flag_url")
  imageUrl    String?  @map("image_url")
  coverImageUrl String? @map("cover_image_url")
  region      String?  // asia, europe, americas, oceania, africa, middle_east
  visaTypes   String[] @default([]) @map("visa_types") // tourist, business, student, work
  processingTime String? @map("processing_time")
  fee         Decimal  @db.Decimal(10, 2)
  currency    String   @default("BDT")
  requirements String[] @default([])
  description String?  @db.Text
  isActive    Boolean  @default(true) @map("is_active")
  isFeatured  Boolean  @default(false) @map("is_featured")
  order       Int      @default(0)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@unique([tenantId, slug])
  @@map("visa_countries")
}

