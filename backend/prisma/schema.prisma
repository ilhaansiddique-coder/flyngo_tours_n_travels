  walkingDistanceToHaram   Int? @map("walking_distance_to_haram")
  walkingDistanceToProphet Int? @map("walking_distance_to_prophet")

  // Trip-style preference for AI itineraries
  preferredRoute String? @map("preferred_route") // makkah_first, madinah_first, combined

  // Loyalty: points awarded when this Umrah package is booked + completed
  pointsAwarded Int @default(0) @map("points_awarded")

