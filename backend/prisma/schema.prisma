model Affiliate {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")
  userId   String @unique @map("user_id")
  user     User   @relation(fields: [userId], references: [id])

  referralCode String @unique @map("referral_code")

  /// fixed_commission = earns cash commission per converted booking;
  /// commission_less = points-only referrer (no cash commissions, no payouts)
  affiliateType  String  @default("fixed_commission") @map("affiliate_type")
  commissionRate Decimal @default(5.0) @map("commission_rate") @db.Decimal(5, 2)
  totalEarnings  Decimal @default(0) @map("total_earnings") @db.Decimal(10, 2)

  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  referrals   AffiliateReferral[]
  commissions AffiliateCommission[]
  payouts     ReferralPayout[]
  ledger      ReferralLedger[]

  @@map("affiliates")
}

model AffiliateReferral {
  id          String    @id @default(uuid())
  tenantId    String    @map("tenant_id")
  affiliateId String    @map("affiliate_id")
  affiliate   Affiliate @relation(fields: [affiliateId], references: [id])

  referredUserId String @map("referred_user_id")
  status         String @default("pending") // pending, registered, converted, cancelled

  registeredAt DateTime? @map("registered_at")
  convertedAt  DateTime? @map("converted_at")
  cancelledAt  DateTime? @map("cancelled_at")

  // Reward snapshot captured at conversion time so future config changes don't retroactively change it
  referrerReward Decimal? @map("referrer_reward") @db.Decimal(10, 2)
  refereeReward  Decimal? @map("referee_reward") @db.Decimal(10, 2)

  // Prevent the referee discount from being reused on multiple bookings.
  discountUsedAt DateTime? @map("discount_used_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, referredUserId])
  @@index([tenantId, affiliateId])
  @@map("affiliate_referrals")
}

model AffiliateCommission {
  id          String    @id @default(uuid())
  tenantId    String    @map("tenant_id")
  affiliateId String    @map("affiliate_id")
  affiliate   Affiliate @relation(fields: [affiliateId], references: [id])

  bookingId String   @map("booking_id")
  amount    Decimal  @db.Decimal(10, 2)
  currency  String   @default("USD")
  rate      Decimal? @db.Decimal(5, 2) // snapshot of commissionRate used at conversion time
  status    String   @default("pending") // pending, paid, cancelled

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, bookingId])
  @@index([tenantId, affiliateId])
  @@map("affiliate_commissions")
}

