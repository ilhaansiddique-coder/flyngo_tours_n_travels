// =============================================================================
// LOYALTY / REWARDS — Tier system + per-product points + redemption
// =============================================================================
//
// Tiers (auto-promotion): Silver → Gold → Platinum → Diamond → Ambassador
// Thresholds seeded per tenant: 10K / 50K / 150K / 300K / 500K
// Each tier has a redemptionMultiplier — points redeem for more BDT at higher tiers
// (Silver: 1.0× = 1pt/1BDT, Gold: 1.1×, Platinum: 1.25×, Diamond: 1.5×, Ambassador: 2.0×)
//
// Points earning:
//   - Referral signup: 500 pts to referrer
//   - Booking confirmation: 50% of product.pointsAwarded
//   - Service completion:  remaining 50% of product.pointsAwarded
//
// Redemption: at booking checkout, user applies N points → discount = N × tier.multiplier BDT
// =============================================================================

model LoyaltyTier {
  id                   String   @id @default(uuid())
  tenantId             String   @map("tenant_id")
  name                 String // "Silver", "Gold", "Platinum", "Diamond", "Ambassador"
  slug                 String // "silver" | "gold" | "platinum" | "diamond" | "ambassador"
  color                String // hex: "#C0C0C0", "#FFD700", "#E5E4E2", "#60A5FA", "#7B61FF"
  starCount            Int      @map("star_count")
  minPoints            Int      @map("min_points")
  redemptionMultiplier Decimal  @default(1.0) @map("redemption_multiplier") @db.Decimal(4, 2)
  benefits             Json? // free-form {perks: [...], description: "..."}
  sortOrder            Int      @default(0) @map("sort_order")
  isActive             Boolean  @default(true) @map("is_active")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  accounts LoyaltyAccount[]

  @@unique([tenantId, slug])
  @@index([tenantId, minPoints])
  @@map("loyalty_tiers")
}

model LoyaltyAccount {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")
  userId   String @unique @map("user_id")
  user     User   @relation(fields: [userId], references: [id])

  lifetimePoints  Int @default(0) @map("lifetime_points")
  availablePoints Int @default(0) @map("available_points")
  redeemedPoints  Int @default(0) @map("redeemed_points")

  currentTierId String?      @map("current_tier_id")
  currentTier   LoyaltyTier? @relation(fields: [currentTierId], references: [id])

  tierAchievedAt DateTime? @map("tier_achieved_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  transactions LoyaltyTransaction[]

  @@index([tenantId])
  @@map("loyalty_accounts")
}

model LoyaltyTransaction {
  id        String         @id @default(uuid())
  tenantId  String         @map("tenant_id")
  accountId String         @map("account_id")
  account   LoyaltyAccount @relation(fields: [accountId], references: [id])

  // Type catalog:
  //   referral_signup       — +pts to referrer when a referee signs up
  //   booking_confirmation  — +pts when booking.status = 'confirmed' (50% of product.pointsAwarded)
  //   booking_completion    — +pts when booking.status = 'completed' (remaining 50%)
  //   redemption            — -pts applied at checkout (BDT discount applied)
  //   admin_adjustment      — manual +/- by admin (with reason)
  //   refund                — -pts when booking is refunded/cancelled
  type String

  // Positive = earn, negative = redeem
  points Int

  currency String?  @default("BDT")
  bdtValue Decimal? @map("bdt_value") @db.Decimal(10, 2)

  bookingId   String? @map("booking_id")
  referralId  String? @map("referral_id")
  description String?
  metadata    Json?

  createdAt DateTime @default(now()) @map("created_at")

  @@index([tenantId, accountId])
  @@index([tenantId, type])
  @@index([tenantId, createdAt])
  @@map("loyalty_transactions")
}

model ProductPointsRule {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")

  // Product category: "tour" | "flight" | "hotel" | "visa" | "hajj" | "umrah" | "transport"
  productType String @map("product_type")

  // Null = category-wide default; set = per-product override
  productId   String? @map("product_id")
  productName String? @map("product_name")

  // Direct points per booking of this product (Q3: per-product rule)
  pointsValue Int @default(0) @map("points_value")

  // Optional cap (e.g., "max 1000 points per booking of this product")
  maxPoints Int?     @map("max_points")
  minSpend  Decimal? @map("min_spend") @db.Decimal(10, 2)

  isActive Boolean   @default(true) @map("is_active")
  startsAt DateTime? @map("starts_at")
  endsAt   DateTime? @map("ends_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, productType, productId])
  @@index([tenantId, productType])
  @@map("product_points_rules")
}

enum PointTransactionType {
  SIGNUP_BONUS
  REFERRAL_SIGNUP
  BOOKING_CONFIRMED
  BOOKING_COMPLETED
  REDEMPTION
  ADMIN_ADJUSTMENT
  REVERSAL
}

enum PointTransactionStatus {
  PENDING
  POSTED
  REVERSED
}

enum PointReferenceType {
  BOOKING
  REFERRAL
  REDEMPTION
  ADMIN
  SIGNUP
}

model PointTransaction {
  id             String                 @id @default(uuid())
  userId         String                 @map("user_id")
  user           User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  type           PointTransactionType
  amount         Int
  status         PointTransactionStatus @default(POSTED)
  referenceType  PointReferenceType     @map("reference_type")
  referenceId    String                 @map("reference_id")
  idempotencyKey String                 @unique @map("idempotency_key")
  balanceAfter   Json                   @map("balance_after")
  metadata       Json                   @default("{}")
  createdAt      DateTime               @default(now()) @map("created_at")

  @@unique([referenceType, referenceId, type])
  @@index([userId, createdAt])
  @@index([userId, type, createdAt])
   @@map("point_transactions")
}

// =============================================================================
// WEBHOOK EVENT LOG (payment-gateway idempotency)
// =============================================================================

model WebhookEventLog {
  id        String   @id @default(uuid())
  tenantId  String?  @map("tenant_id")
  provider  String // stripe | bkash
  eventId   String   @map("event_id")
  eventType String?  @map("event_type")
  payload   Json?
  processed Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([provider, eventId])
  @@index([provider, createdAt])
  @@map("webhook_event_logs")
}

// =============================================================================
// PASSWORD RESET TOKENS
// =============================================================================
// A single-use, time-limited token delivered over the channel the user chose
// (email or SMS). Only a SHA-256 hash of the token is stored — the raw token
// lives only in the reset link that was sent.

model PasswordReset {
  id          String    @id @default(uuid())
  tenantId    String    @map("tenant_id")
  userId      String    @map("user_id")
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash   String    @unique @map("token_hash")
  channel     String // email | sms
  destination String? // the address/number the link was sent to (for audit)
  expiresAt   DateTime  @map("expires_at")
  usedAt      DateTime? @map("used_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@map("password_resets")
}

// =============================================================================
// USER DOCUMENTS (customer-uploaded files: passport, ID, tickets, photos…)
// =============================================================================
// Files a user attaches to their own profile. The binary lives in media
// storage (R2 / local); this row keeps the metadata + public URL so they can
// list and download them.

model UserDocument {
  id        String    @id @default(uuid())
  tenantId  String    @map("tenant_id")
  userId    String    @map("user_id")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  url       String
  filename  String
  mimeType  String?   @map("mime_type")
  size      Int?
  kind      String    @default("document") // document | image
  createdAt DateTime  @default(now()) @map("created_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([userId, deletedAt])
  @@map("user_documents")
}
