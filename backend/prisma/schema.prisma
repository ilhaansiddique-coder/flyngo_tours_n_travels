generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearchPostgres"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =============================================================================
// TENANT & MULTI-TENANCY
// =============================================================================

model Tenant {
  id        String    @id @default(uuid())
  name      String
  slug      String    @unique
  domain    String?   @unique
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  settings TenantSettings?
  users    User[]
  roles    Role[]

  @@map("tenants")
}

model TenantSettings {
  id       String @id @default(uuid())
  tenantId String @unique @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  logoUrl        String? @map("logo_url")
  faviconUrl     String? @map("favicon_url")
  primaryColor   String? @default("#2563eb") @map("primary_color")
  secondaryColor String? @default("#1e40af") @map("secondary_color")

  companyName    String? @map("company_name")
  companyEmail   String? @map("company_email")
  companyPhone   String? @map("company_phone")
  companyAddress String? @map("company_address")

  defaultCurrency String? @default("USD") @map("default_currency")
  defaultLanguage String? @default("en") @map("default_language")
  timezone        String? @default("UTC")

  // Payment gateway keys (encrypted at rest)
  stripePublicKey String? @map("stripe_public_key")
  stripeSecretKey String? @map("stripe_secret_key")
  bkashApiKey     String? @map("bkash_api_key")
  nagadMerchantId String? @map("nagad_merchant_id")
  sslcStoreId     String? @map("sslc_store_id")

  // Offline payment details shown at checkout (no gateway)
  bkashWalletNumber   String? @map("bkash_wallet_number")
  bkashMerchantName   String? @map("bkash_merchant_name")
  paymentInstructions String? @map("payment_instructions") @db.Text

  // Analytics
  ga4Id       String? @map("ga4_id")
  gtmId       String? @map("gtm_id")
  metaPixelId String? @map("meta_pixel_id")

  // Social
  facebookUrl  String? @map("facebook_url")
  instagramUrl String? @map("instagram_url")
  twitterUrl   String? @map("twitter_url")
  youtubeUrl   String? @map("youtube_url")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("tenant_settings")
}

// =============================================================================
// AUTH & USERS
// =============================================================================

model User {
  id           String  @id @default(uuid())
  tenantId     String  @map("tenant_id")
  tenant       Tenant  @relation(fields: [tenantId], references: [id])
  email        String?
  fullName     String  @map("full_name")
  phone        String?
  address      String? @map("address")
  avatarUrl    String? @map("avatar_url")

  // Identity / travel documents (admin-managed on the customer record)
  nationalId        String? @map("national_id")
  nationalIdFrontUrl String? @map("national_id_front_url")
  nationalIdBackUrl  String? @map("national_id_back_url")
  passportNumber    String? @map("passport_number")
  passportUrl       String? @map("passport_url")

  passwordHash String? @map("password_hash")
  provider     String? @map("provider")
  providerId   String? @map("provider_id")
  roleId       String  @map("role_id")
  role         Role    @relation(fields: [roleId], references: [id])

  isActive        Boolean   @default(true) @map("is_active")
  emailVerifiedAt DateTime? @map("email_verified_at")
  lastLoginAt     DateTime? @map("last_login_at")
  refreshToken    String?   @map("refresh_token")
  phoneVerifiedAt DateTime? @map("phone_verified_at")

  // ---------------------------------------------------------------------------
  // Capture-first accounts
  // ---------------------------------------------------------------------------
  // Booking no longer requires an account. A booking creates a PROVISIONAL user
  // (passwordHash null → cannot authenticate by any route), staff then issue a
  // one-time temporary password over WhatsApp, and the customer sets their own
  // on first login. States: provisional → invited → active.
  accountStatus String @default("active") @map("account_status")

  // Canonical phone match key (last 10 digits) — the same rule login already
  // used, so "+880 1712345678", "01712345678" and "8801712345678" resolve to one
  // account instead of three. Unique per tenant; this is what makes the upsert
  // on a booking safe.
  phoneKey String? @map("phone_key")

  mustChangePassword    Boolean   @default(false) @map("must_change_password")
  tempPasswordExpiresAt DateTime? @map("temp_password_expires_at")
  credentialsSentAt     DateTime? @map("credentials_sent_at")
  claimedAt             DateTime? @map("claimed_at")

  // Refer & Earn attribution (set when the user signs up via ?ref=CODE)
  referredByCode String? @map("referred_by_code")
  referralCode   String? @unique @map("referral_code")

  // Loyalty / Rewards — denormalized for fast badge rendering
  lifetimePoints  Int       @default(0) @map("lifetime_points")
  availablePoints Int       @default(0) @map("available_points")
  pendingPoints   Int       @default(0) @map("pending_points")
  currentTierId   String?   @map("current_tier_id")
  tierAchievedAt  DateTime? @map("tier_achieved_at")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  bookings       Booking[]
  payments       Payment[]
  notifications  Notification[]
  auditLogs      AuditLog[]
  blogPosts      BlogPost[]
  reviews        Review[]
  affiliate      Affiliate?
  loyaltyAccount LoyaltyAccount?
deviceTokens       DeviceToken[]
  hajjUmrahBookings  HajjUmrahBooking[]
  pointTransactions  PointTransaction[]
  passwordResets     PasswordReset[]
  documents          UserDocument[]
  invoices           Invoice[]

  @@unique([tenantId, phoneKey], map: "users_tenant_phone_key_key")
  @@index([tenantId, email])
  @@index([tenantId, phone])
  @@map("users")
}

// =============================================================================
// DEVICE TOKENS — Firebase Cloud Messaging (push notifications)
// =============================================================================

model DeviceToken {
  id        String    @id @default(uuid())
  tenantId  String    @map("tenant_id")
  userId    String    @map("user_id")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String
  platform  String?  // ios, android, web
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@unique([userId, token])
  @@index([tenantId, userId])
  @@map("device_tokens")
}

// =============================================================================
// REFERRALS (Refer & Earn)
// =============================================================================

model ReferralSetting {
  id       String @id @default(uuid())
  tenantId String @unique @map("tenant_id")

  isEnabled Boolean @default(true) @map("is_enabled")

  // Referrer (the person who refers) reward
  referrerRewardType  String   @default("percentage") @map("referrer_reward_type") // percentage, fixed
  referrerRewardValue Decimal  @default(5.0) @map("referrer_reward_value") @db.Decimal(10, 2)
  referrerMaxReward   Decimal? @map("referrer_max_reward") @db.Decimal(10, 2)

  /// Loyalty points awarded to the REFERRER when a user they referred signs up.
  /// Default 0 (off): the referrer's real earning is the commission on the
  /// referee's actual purchases (conversion). Set > 0 to also reward the signup
  /// itself. Only credited for verified signups, to limit fake-signup farming.
  referrerSignupPoints Int @default(0) @map("referrer_signup_points")

  /// Default affiliate type assigned to newly enrolled referrers:
  /// fixed_commission | commission_less
  defaultAffiliateType String @default("fixed_commission") @map("default_affiliate_type")

  /// Conditions for "fixed commission" affiliates
  fixedCommissionType  String  @default("percentage") @map("fixed_commission_type") // percentage, fixed
  fixedCommissionValue Decimal @default(5.0) @map("fixed_commission_value") @db.Decimal(10, 2)

  /// Conditions for "commission-less" affiliates — loyalty points per signup
  commissionlessSignupPoints Int @default(500) @map("commissionless_signup_points")

  /// Signup bonus — loyalty points every new user receives the moment they
  /// register (independent of referrals). Credited as available immediately.
  signupBonusPoints Int @default(100) @map("signup_bonus_points")

  // Referee (the person who was referred) reward
  refereeRewardType  String   @default("percentage") @map("referee_reward_type")
  refereeRewardValue Decimal  @default(5.0) @map("referee_reward_value") @db.Decimal(10, 2)
  refereeMaxReward   Decimal? @map("referee_max_reward") @db.Decimal(10, 2)

  // Cookie window — days the referral attribution is valid after the link is clicked
  cookieWindowDays Int @default(30) @map("cookie_window_days")

  // Payout settings
  minPayoutAmount Decimal @default(20.0) @map("min_payout_amount") @db.Decimal(10, 2)
  payoutCurrency  String  @default("USD") @map("payout_currency")

  // Conversion triggers: which booking statuses count as a "conversion"
  conversionStatuses String[] @default(["confirmed", "in_progress", "completed"]) @map("conversion_statuses")

  // Branding for the referral landing page
  heroTitle    String? @map("hero_title")
  heroSubtitle String? @map("hero_subtitle") @db.Text
  termsText    String? @map("terms_text") @db.Text

  // Per-channel share message templates. Each is a string with the
  // following placeholders that the server substitutes at request time:
  //   {brand}            — tenant brand / company name
  //   {refereeReward}    — formatted reward (e.g. "5% off", "10 USD off")
  //   {referrerReward}   — formatted referrer reward
  //   {referralCode}     — the user's uppercase referral code
  //   {shareLink}        — full https://...?ref=CODE URL
  //   {refereeName}      — first name of the referrer (for "Invited by …")
  shareMessageTemplates Json? @map("share_message_templates")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("referral_settings")
}

model ReferralPayout {
  id          String    @id @default(uuid())
  tenantId    String    @map("tenant_id")
  affiliateId String    @map("affiliate_id")
  affiliate   Affiliate @relation(fields: [affiliateId], references: [id])

  amount   Decimal @db.Decimal(10, 2)
  currency String  @default("USD")
  method   String // bank_transfer, bkash, nagad, paypal, stripe, manual
  details  Json?

  status      String    @default("pending") // pending, processing, paid, rejected, cancelled
  notes       String?   @db.Text
  processedBy String?   @map("processed_by") // admin user id
  processedAt DateTime? @map("processed_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([tenantId, affiliateId])
  @@index([tenantId, status])
  @@map("referral_payouts")
}

model ReferralLedger {
  id          String    @id @default(uuid())
  tenantId    String    @map("tenant_id")
  affiliateId String    @map("affiliate_id")
  affiliate   Affiliate @relation(fields: [affiliateId], references: [id])

  type     String // signup, conversion, refund, adjustment, payout_debit
  amount   Decimal @db.Decimal(10, 2) // positive = credit to affiliate, negative = debit
  currency String  @default("USD")

  bookingId      String? @map("booking_id")
  referredUserId String? @map("referred_user_id")
  payoutId       String? @map("payout_id")
  description    String? @db.Text

  createdAt DateTime @default(now()) @map("created_at")

  @@index([tenantId, affiliateId])
  @@index([tenantId, createdAt])
  @@map("referral_ledger")
}

model Role {
  id       String  @id @default(uuid())
  tenantId String  @map("tenant_id")
  tenant   Tenant  @relation(fields: [tenantId], references: [id])
  name     String
  code     String
  isSystem Boolean @default(false) @map("is_system")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  users       User[]
  permissions RolePermission[]

  @@unique([tenantId, code])
  @@map("roles")
}

model Permission {
  id          String  @id @default(uuid())
  name        String
  code        String  @unique
  description String?
  group       String?

  createdAt DateTime @default(now()) @map("created_at")

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  id           String     @id @default(uuid())
  roleId       String     @map("role_id")
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String     @map("permission_id")
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

// =============================================================================
// DESTINATIONS
// =============================================================================

model Destination {
  id            String  @id @default(uuid())
  tenantId      String  @map("tenant_id")
  name          String
  slug          String
  country       String
  continent     String?
  description   String? @db.Text
  imageUrl      String? @map("image_url")
  flagUrl       String? @map("flag_url")
  coverImageUrl String? @map("cover_image_url")
  latitude      Float?
  longitude     Float?
  isFeatured    Boolean @default(false) @map("is_featured")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  tours           Tour[]
  hotels          Hotel[]
  visaServices    VisaService[]
  tourLinks       TourDestination[]
  hotelLinks      HotelDestination[]
  visaLinks       VisaDestination[]

  @@unique([tenantId, slug])
  @@map("destinations")
}

// Join table: additional destinations for a tour (destinationId is the primary).
model TourDestination {
  id            String      @id @default(uuid())
  tenantId      String      @map("tenant_id")
  tourId        String      @map("tour_id")
  destinationId String      @map("destination_id")
  position      Int         @default(0)
  tour          Tour        @relation(fields: [tourId], references: [id], onDelete: Cascade)
  destination   Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)

  @@unique([tourId, destinationId])
  @@index([destinationId])
  @@map("tour_destinations")
}

// Join table: additional destinations for a hotel (destinationId is the primary).
model HotelDestination {
  id            String      @id @default(uuid())
  tenantId      String      @map("tenant_id")
  hotelId       String      @map("hotel_id")
  destinationId String      @map("destination_id")
  position      Int         @default(0)
  hotel         Hotel       @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  destination   Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)

  @@unique([hotelId, destinationId])
  @@index([destinationId])
  @@map("hotel_destinations")
}

// Join table: additional destinations for a visa service (destinationId is the primary).
model VisaDestination {
  id            String      @id @default(uuid())
  tenantId      String      @map("tenant_id")
  visaServiceId String      @map("visa_service_id")
  destinationId String      @map("destination_id")
  position      Int         @default(0)
  visaService   VisaService @relation(fields: [visaServiceId], references: [id], onDelete: Cascade)
  destination   Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)

  @@unique([visaServiceId, destinationId])
  @@index([destinationId])
  @@map("visa_destinations")
}

// =============================================================================
// TOURS
// =============================================================================

model Tour {
  id            String      @id @default(uuid())
  tenantId      String      @map("tenant_id")
  destinationId String      @map("destination_id")
  destination   Destination @relation(fields: [destinationId], references: [id])

  title       String
  slug        String
  description String   @db.Text
  highlights  String[] @default([])
  inclusions  String[] @default([])
  exclusions  String[] @default([])
  price     Decimal  @db.Decimal(10, 2)
  salePrice Decimal? @map("sale_price") @db.Decimal(10, 2)
  currency  String   @default("USD")

  duration      Int
  maxGuests     Int     @default(10) @map("max_guests")
  difficulty    String? // easy, moderate, challenging
  tourType      String? @map("tour_type") // group, private, adventure, luxury
  startLocation String? @map("start_location")
  endLocation   String? @map("end_location")

  isActive   Boolean @default(true) @map("is_active")
  isFeatured Boolean @default(false) @map("is_featured")

  coverImageUrl String? @map("cover_image_url")

  // Loyalty: points awarded when this tour is booked + service completed
  pointsAwarded Int @default(0) @map("points_awarded")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  images    Media[]
  itinerary ItineraryDay[]
  additionalDestinations TourDestination[]

  @@unique([tenantId, slug])
  @@map("tours")
}

model ItineraryDay {
  id          String   @id @default(uuid())
  tourId      String   @map("tour_id")
  tour        Tour     @relation(fields: [tourId], references: [id], onDelete: Cascade)
  day         Int
  title       String
  description String   @db.Text
  activities  String[]

  @@unique([tourId, day])
  @@map("itinerary_days")
}

// =============================================================================
// HOTELS
// =============================================================================

model Hotel {
  id            String      @id @default(uuid())
  tenantId      String      @map("tenant_id")
  destinationId String      @map("destination_id")
  destination   Destination @relation(fields: [destinationId], references: [id])

  name        String
  slug        String
  description String  @db.Text
  starRating  Int     @default(3) @map("star_rating")
  address     String?
  latitude    Float?
  longitude   Float?

  pricePerNight Decimal @map("price_per_night") @db.Decimal(10, 2)
  currency      String  @default("USD")

  amenities    String[] @default([])
  checkInTime  String?  @default("14:00") @map("check_in_time")
  checkOutTime String?  @default("12:00") @map("check_out_time")

  coverImageUrl String? @map("cover_image_url")

  isActive Boolean @default(true) @map("is_active")

  // Loyalty: points awarded when this hotel is booked + service completed
  pointsAwarded Int @default(0) @map("points_awarded")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  images Media[]
  rooms  Room[]
  additionalDestinations HotelDestination[]

  @@unique([tenantId, slug])
  @@map("hotels")
}

model Room {
  id      String @id @default(uuid())
  hotelId String @map("hotel_id")
  hotel   Hotel  @relation(fields: [hotelId], references: [id], onDelete: Cascade)

  name          String
  description   String?
  pricePerNight Decimal  @map("price_per_night") @db.Decimal(10, 2)
  currency      String   @default("USD")
  capacity      Int
  available     Int      @default(1)
  amenities     String[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("rooms")
}

// =============================================================================
// FLIGHTS
// =============================================================================

model Flight {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")

  airline         String
  flightNumber    String  @map("flight_number")
  originCode      String  @map("origin_code")
  originCity      String? @map("origin_city")
  destinationCode String  @map("destination_code")
  destinationCity String? @map("destination_city")

  coverImageUrl String? @map("cover_image_url")

  departureTime DateTime @map("departure_time")
  arrivalTime   DateTime @map("arrival_time")
  duration      Int? // minutes

  price          Decimal @db.Decimal(10, 2)
  currency       String  @default("USD")
  availableSeats Int     @default(0) @map("available_seats")
  cabinClass     String? @map("cabin_class") // economy, business, first

  isActive Boolean @default(true) @map("is_active")

  // Loyalty: points awarded when this flight is booked + service completed
  pointsAwarded Int @default(0) @map("points_awarded")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@map("flights")
}

// =============================================================================
// VISA
// =============================================================================

model VisaService {
  id            String      @id @default(uuid())
  tenantId      String      @map("tenant_id")
  destinationId String      @map("country_id")
  country       Destination @relation(fields: [destinationId], references: [id])

  title          String
  description    String   @db.Text
  processingTime String?  @map("processing_time")
  price          Decimal  @db.Decimal(10, 2)
  currency       String   @default("USD")
  requirements   String[]

  isActive Boolean @default(true) @map("is_active")

  // Loyalty: points awarded when this visa is processed
  pointsAwarded Int @default(0) @map("points_awarded")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  additionalDestinations VisaDestination[]

  @@map("visa_services")
}

// =============================================================================
// BOOKINGS
// =============================================================================

model Booking {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")
  userId   String? @map("user_id")
  user     User?   @relation(fields: [userId], references: [id])

  bookingType String @map("booking_type") // tour, hotel, flight, visa, package
  bookingCode String @unique @map("booking_code")
  itemId      String @map("item_id")

  // Customer contact, captured on EVERY booking (guest or signed-in) so the
  // admin table always shows who booked — independent of whether the row links
  // to a user account.
  customerName  String? @map("customer_name")
  customerPhone String? @map("customer_phone")

  status    String    @default("pending") // pending, confirmed, in_progress, completed, cancelled
  startDate DateTime  @map("start_date")
  endDate   DateTime? @map("end_date")
  guests    Int       @default(1)

  totalAmount    Decimal  @default(0) @map("total_amount") @db.Decimal(10, 2)
  discountAmount Decimal? @default(0) @map("discount_amount") @db.Decimal(10, 2)
  paidAmount     Decimal  @default(0) @map("paid_amount") @db.Decimal(10, 2)
  currency       String   @default("USD")

  couponCode String? @map("coupon_code")
  notes      String?

  // Flow-specific answers with no dedicated column — the visa application
  // (passport/DOB/purpose/document checklist) and the custom-quote brief.
  // Both wizards collected this and then dropped it on submit, so staff had to
  // phone the customer back for details they had already typed in.
  meta Json? @map("meta")

  // Referral attribution — set if this booking originated from a Refer & Earn link
  referredByCode      String?   @map("referred_by_code")
  referralDiscount    Decimal   @default(0) @map("referral_discount") @db.Decimal(10, 2)
  referralProcessedAt DateTime? @map("referral_processed_at")

  // Loyalty / Rewards — points awarded at each lifecycle stage
  pointsAwardedConfirmation Int     @default(0) @map("points_awarded_confirmation") // 50% on confirmation
  pointsAwardedCompletion   Int     @default(0) @map("points_awarded_completion") // remaining 50% on completion
  pointsRedeemed            Int     @default(0) @map("points_redeemed") // points applied at checkout
  pointsRedemptionBdt       Decimal @default(0) @map("points_redemption_bdt") @db.Decimal(10, 2)

  // Ad-attribution (UTM + click ids)
  utmSource   String? @map("utm_source")
  utmMedium   String? @map("utm_medium")
  utmCampaign String? @map("utm_campaign")
  utmContent  String? @map("utm_content")
  utmTerm     String? @map("utm_term")
  gclid       String? @map("gclid") // Google Ads click id
  fbclid      String? @map("fbclid") // Meta Ads click id
  msclkid     String? @map("msclkid") // Bing click id
  landingPath String? @map("landing_path") // first page they touched

  // Hajj-specific
  departureCity String? @map("departure_city")
  groupType     String? @map("group_type") // group, private, vip
  packageSlug   String? @map("package_slug") // hajj-package or umrah-package slug

  // Hotel-specific fields
  hotelId       String?  @map("hotel_id")
  roomId        String?  @map("room_id")
  hotelName     String?  @map("hotel_name")
  roomName      String?  @map("room_name")
  roomsCount    Int      @default(1) @map("rooms_count")
  adults        Int      @default(1)
  children      Int      @default(0)
  childAges     Int[]    @default([]) @map("child_ages")
