# Backend URL for Next.js API proxy rewrites (not a NEXT_PUBLIC_ var — server-side only)
BACKEND_URL=http://localhost:4000

# Public backend URL exposed to the browser for OAuth redirects.
# Must match the FQDN attached to the backend container (e.g. https://api.flyngo.world).
# Build-time baked in — rebuild frontend after changing.
NEXT_PUBLIC_API_URL=http://localhost:4000

# Site URLs
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_ADMIN_URL=http://localhost:3001

# Analytics
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_TIKTOK_PIXEL_ID=
NEXT_PUBLIC_CLARITY_ID=

# Google Maps
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Stripe (client-side)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_
